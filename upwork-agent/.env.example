# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to the upwork-mcp server entry point (absolute or relative to this dir)
UPWORK_MCP_PATH=../upwork-mcp/src/index.js

# How often to run the agent (cron syntax). Default: every 6 hours
# Examples: "0 */6 * * *" = every 6h, "0 9 * * *" = daily at 9am
AGENT_CRON=0 */6 * * *

# Dry run: search and score jobs but never submit proposals (true/false)
DRY_RUN=false
